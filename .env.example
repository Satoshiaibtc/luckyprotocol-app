# Copy to .env.local (gitignored) and adjust.

# Indexer origin (PROTOCOL-v3.md §5). Must be https://, or http:// to
# localhost / 127.0.0.1. The build writes dist/_headers (CSP connect-src /
# img-src) from this value — see scripts/gen-headers.mjs.
VITE_INDEXER_URL=https://luckyprotocolai.com

# 1 = deterministic fake indexer + optional simulated wallet (demo mode).
# Leave unset / 0 for a live indexer.
VITE_MOCK=0

# Where the footer "Protocol spec" link points. Default: the copy served at
# /PROTOCOL-v3.md from public/.
# VITE_SPEC_URL=/PROTOCOL-v3.md
