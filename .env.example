# Copy to .env.local (gitignored) and adjust.

# Indexer origin (PROTOCOL-v3-HASHMINT.md §5). Must be https://, or http:// to
# localhost / 127.0.0.1. Also add it to connect-src in public/_headers.
VITE_INDEXER_URL=http://127.0.0.1:8765

# 1 = deterministic fake indexer + optional simulated wallet (demo mode).
# Leave unset / 0 for a live indexer.
VITE_MOCK=0

# Where the footer "Protocol spec" link points. Default: the copy served at
# /PROTOCOL-v3-HASHMINT.md from public/.
# VITE_SPEC_URL=/PROTOCOL-v3-HASHMINT.md
