# Copy to .env.local (gitignored) and adjust.

# Indexer origin. Must be https://, or http:// to
# localhost / 127.0.0.1. `npm run build` writes dist/_headers (CSP
# connect-src / img-src), dist/_routes.json and functions/_middleware.js
# (generated, gitignored) from this value — see scripts/gen-headers.mjs.
VITE_INDEXER_URL=https://app.luckyprotocolai.com

# 1 = deterministic fake indexer + optional simulated wallet (demo mode).
# Leave unset / 0 for a live indexer.
VITE_MOCK=0

